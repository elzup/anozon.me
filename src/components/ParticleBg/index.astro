---
import type { ParticlePreset } from './presets'

export interface Props {
	preset?: ParticlePreset
	// fill: 親の箱いっぱいに敷く / sticky: 画面に貼り付けたまま中身をその上に流す
	// gutter: sticky と同じ重ね方で、中央のコンテンツ幅だけ mask で抜いて左右の余白にだけ見せる
	mode?: 'fill' | 'sticky' | 'gutter'
}
const { preset, mode: defaultMode = 'fill' } = Astro.props
// preset 側の指定を優先する (短いセクションは sticky だと 100vh まで伸びてしまうので fill にしたい等)
const mode = preset?.mode ?? defaultMode
// count と mobile 上書きはクライアントで画面サイズを見てから属性にする (下の script)
// OS の「視差効果を減らす」が ON でも静止画にせず常に動かす (サイトの方針。preset で 'true' を渡せば戻せる)
const { count, ...attrs } = preset?.params ?? {}
---

{
	preset ? (
		<div
			class:list={[
				'pbg',
				mode === 'fill' ? 'fill' : 'sticky',
				mode === 'gutter' && 'gutter',
				preset.night && 'night',
			]}
		>
			<particle-life-bg
				class="layer"
				respect-reduced-motion="false"
				{...attrs}
				data-base-count={count}
				data-mobile={JSON.stringify(preset.mobile ?? {})}
				data-week-colors={preset.weekColors ? '' : undefined}
				data-aster-spawn={preset.asterSpawn ? '' : undefined}
			/>
			<div class="body">
				<slot />
			</div>
			<aside class="params" aria-label="particle parameters">
				<span class="params-badge">params</span>
				<div class="params-panel" data-param-panel />
			</aside>
		</div>
	) : (
		<slot />
	)
}

<script>
	import { ensureSeed, renderParamTable } from './paramTable'
	import { applyResponsive } from './responsive'
	import { createAsterSpawn } from './asterSpawn'
	import { weekTypeColors } from './weekColor'

	const elements = [...document.querySelectorAll<HTMLElement>('particle-life-bg[data-base-count]')]

	// 属性を決めてから element を登録する。先に登録すると既定値で 1 回 spawn してから作り直しになる
	elements.forEach((el) => {
		applyResponsive(el)
		ensureSeed(el)
		// build 時ではなく閲覧時の曜日にする (静的サイトなので build 日の色で固まってしまう)
		if (el.hasAttribute('data-week-colors')) {
			// 曜日によって種類数が 6 か 7 に変わるので types も合わせる
			const colors = weekTypeColors()
			el.setAttribute('types', String(colors.length))
			el.setAttribute('colors', colors.join(' '))
		}
		// spawn は関数なので属性では渡せない。登録前に代入しておくと element が最初の撒きで拾う
		if (el.hasAttribute('data-aster-spawn')) {
			Object.assign(el, { options: { spawn: createAsterSpawn() } })
		}
	})
	import('particle-life-bg/element')
		.then(() => customElements.whenDefined('particle-life-bg'))
		.then(() =>
			elements.forEach((el) => {
				const params = el.parentElement?.querySelector<HTMLElement>(':scope > .params')
				const panel = params?.querySelector<HTMLElement>('[data-param-panel]')
				if (!params || !panel) return
				renderParamTable(el, panel)
				params.addEventListener('mouseenter', () => renderParamTable(el, panel))
			})
		)
		.catch((error) => console.error('[ParticleBg] particle-life-bg の読み込みに失敗', error))
</script>

<style>
	.pbg {
		position: relative;
	}

	.fill {
		height: 100%;
	}

	.fill .layer {
		position: absolute;
		inset: 0;
	}

	.body {
		position: relative;
		height: 100%;
	}

	/* sticky: 背景を 100vh で貼り付け、中身を同じ高さだけ引き上げて重ねる */
	.sticky .layer {
		position: sticky;
		top: 0;
		height: 100vh;
	}

	.sticky .body {
		margin-top: -100vh;
		min-height: 100vh;
		/* 子の margin が外へ抜けて重なりがずれないよう BFC を作る */
		display: flow-root;
	}

	/* 暗い背景の preset。中の文字は --text / --text-dim を読む (ProfileScreen, Screen) */
	.night {
		color: #ececec;
		--text-dim: #b8b8b8;
		--rule: #444;
	}

	/* 右下の小さなバッジ。hover した時だけ引力行列の表を開く */
	.params {
		position: absolute;
		right: 8px;
		bottom: 8px;
		z-index: 1;
		font: 10px/1.3 ui-monospace, monospace;
	}

	.params-badge {
		display: block;
		text-align: right;
		opacity: 0.35;
		cursor: default;
	}

	.params-panel {
		display: none;
		position: absolute;
		right: 0;
		bottom: 100%;
		padding: 6px;
		/* バッジは地の文字色を継ぐが、表は白い板なので暗い背景の preset でも暗い文字に固定する */
		color: #333;
		background: rgba(255, 255, 255, 0.92);
		border-radius: 4px;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
		white-space: nowrap;
	}

	.params:hover .params-badge {
		opacity: 0.8;
	}

	.params:hover .params-panel {
		display: block;
	}

	.params-panel :global(p) {
		margin: 0 0 4px;
	}

	.params-panel :global(table) {
		border-collapse: collapse;
	}

	/* Layout.astro の `* { font-family }` が要素ごとに当たり、親からの monospace の継承を潰すので各セルに直接書く */
	.params-badge,
	.params-panel :global(p),
	.params-panel :global(th),
	.params-panel :global(td) {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-variant-numeric: tabular-nums;
	}

	.params-panel :global(th),
	.params-panel :global(td) {
		padding: 1px 3px;
		text-align: right;
		font-weight: normal;
	}

	/* 行見出し (番号 + draw-style の略字) は左揃え */
	.params-panel :global(tr > th:first-child) {
		text-align: left;
	}

	/* 種類の色見本。gray scheme だと白に近い色もあるので枠を付ける */
	.params-panel :global(th)::before {
		content: '';
		display: inline-block;
		width: 7px;
		height: 7px;
		margin-right: 2px;
		background: var(--swatch, transparent);
		border: 1px solid rgba(0, 0, 0, 0.3);
		vertical-align: middle;
	}

	.params-panel :global(tr:first-child th:first-child)::before {
		display: none;
	}

	/* 中央 (Works の 960px 幅 + 少しの余裕) を透明にし、端へ向けて fade で出す。
	   canvas を 2 枚に分けると sim も 2 つ回るので、1 枚を mask で抜く */
	.gutter {
		--gutter-hole: min(1000px, 96vw);
		--gutter-fade: 120px;
	}

	.gutter .layer {
		mask-image: linear-gradient(
			to right,
			#000 0,
			#000 calc(50% - var(--gutter-hole) / 2 - var(--gutter-fade)),
			transparent calc(50% - var(--gutter-hole) / 2),
			transparent calc(50% + var(--gutter-hole) / 2),
			#000 calc(50% + var(--gutter-hole) / 2 + var(--gutter-fade)),
			#000 100%
		);
	}
</style>
